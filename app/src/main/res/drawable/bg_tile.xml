<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF292D35" />
            <corners android:radius="22dp" />
            <stroke android:width="3dp" android:color="#FFF4F6FA" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF303641" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF171A20" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#FF303640" />
        </shape>
    </item>
</selector>
