<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="rectangle">
        <solid android:color="#FF303134" /><corners android:radius="26dp" />
        <stroke android:width="3dp" android:color="#FFFFFFFF" />
    </shape></item>
    <item android:state_pressed="true"><shape android:shape="rectangle">
        <solid android:color="#FF292A2D" /><corners android:radius="26dp" />
    </shape></item>
    <item><shape android:shape="rectangle">
        <solid android:color="#FF202124" /><corners android:radius="26dp" />
        <stroke android:width="1dp" android:color="#FF3A3B3E" />
    </shape></item>
</selector>