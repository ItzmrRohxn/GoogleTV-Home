<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FF17334D" android:endColor="#FF244D68" />
            <corners android:radius="18dp" />
            <stroke android:width="3dp" android:color="@color/focus_ring" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FF17334D" android:endColor="#FF244D68" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FF101C31" android:endColor="#FF172B40" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#FF29465D" />
        </shape>
    </item>
</selector>
