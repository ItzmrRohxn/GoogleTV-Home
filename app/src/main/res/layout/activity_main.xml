<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">
    <ImageView android:id="@+id/wallpaper" android:layout_width="match_parent"
        android:layout_height="match_parent" android:background="#FF000000"
        android:importantForAccessibility="no" android:scaleType="centerCrop" />
    <View android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/scrim_wallpaper" />
    <ScrollView android:id="@+id/scroll" android:layout_width="match_parent"
        android:layout_height="match_parent" android:clipChildren="false"
        android:clipToPadding="false" android:fadingEdge="none"
        android:overScrollMode="never" android:scrollbars="none">
        <LinearLayout android:id="@+id/content" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:clipChildren="false"
            android:clipToPadding="false" android:orientation="vertical"
            android:paddingBottom="96dp" android:paddingTop="88dp">
            <FrameLayout android:id="@+id/banner" android:layout_width="match_parent"
                android:layout_height="0dp" android:visibility="gone"
                android:clickable="false" android:focusable="false" />
        </LinearLayout>
    </ScrollView>
    <FrameLayout android:layout_width="match_parent" android:layout_height="72dp"
        android:background="@android:color/transparent">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|left"
            android:layout_marginLeft="@dimen/screen_margin" android:text="Apps"
            android:textColor="@color/text_primary" android:textSize="28sp"
            android:textStyle="bold" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|right"
            android:layout_marginRight="@dimen/screen_margin"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format12Hour="EEE, d MMM" android:format24Hour="EEE, d MMM"
                android:textColor="@color/text_secondary" android:textSize="15sp" />
            <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginLeft="22dp" android:format12Hour="h:mm a"
                android:format24Hour="HH:mm" android:textColor="@color/text_primary"
                android:textSize="19sp" android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>